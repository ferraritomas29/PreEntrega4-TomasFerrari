    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "a1b2c3d4-0001-4000-8000-bbbbbbbbbbbb",
              "leftValue": "={{ (() => { const h = $json.headers || {}; const auto = String(h['auto-submitted'] || '').toLowerCase(); const prec = String(h['precedence'] || '').toLowerCase(); const subj = String($json.subject || '').toLowerCase(); const from = String($json.from?.value?.[0]?.address || '').toLowerCase(); return (auto !== '' && auto !== 'no') || ['bulk', 'junk', 'auto_reply', 'list'].includes(prec) || !!h['x-autoreply'] || !!h['x-autorespond'] || /respuesta autom|auto.?reply|automatic reply|out of office|fuera de la oficina|undeliverable/.test(subj) || /no-?reply|mailer-daemon|postmaster/.test(from); })() }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5148b422-e806-4d81-8d9c-5673043b84eb",
      "name": "IF - Anti Auto-Reply",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -1504,
        160
      ],
      "notes": "TRUE = el correo es una respuesta automática (el flujo se detiene, la salida true no está conectada). FALSE = correo real, el flujo continúa."
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Remitente: {{ $json.from.value[0].address }}\nAsunto: {{ $json.subject }}\n\nMensaje recibido:\n{{ $json.text }}\n\nClasificá el correo y redactá la respuesta para el cliente.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "Sos el asistente de atención al cliente de \"Mi Piace Gelato\", una heladería artesanal ubicada en General Mitre 73. Tu tarea es analizar cada correo entrante, clasificarlo y redactar una respuesta lista para ser revisada por una persona antes de enviarse.\n\nCategorías posibles: Consulta, Pedido, Reclamo, Sugerencia, Otro.\n\nReglas para la respuesta:\n- Escribí en español rioplatense, con un tono cálido, cercano y profesional.\n- Saludá por el nombre del cliente si lo tenés; si no, usá un saludo cordial.\n- Sé breve y claro.\n- Nunca inventes precios, sabores, promociones, horarios ni datos que no estén en el correo: si no tenés la información, indicá que se la confirmarán a la brevedad.\n- Si es un reclamo, mostrá empatía y pedí disculpas.\n- Cerrá la respuesta con: \"Un saludo, el equipo de Mi Piace Gelato\".\n\nDevolvé la salida únicamente en el formato estructurado solicitado (categoria y respuesta).",
          "maxIterations": 5
        }
      },
      "id": "3d435672-e372-4b3f-9f7e-ca7e9d4a287a",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        -1232,
        160
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"categoria\": {\n      \"type\": \"string\",\n      \"enum\": [\"Consulta\", \"Pedido\", \"Reclamo\", \"Sugerencia\", \"Otro\"]\n    },\n    \"respuesta\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\"categoria\", \"respuesta\"]\n}"
      },
      "id": "c0ef2170-288a-4a91-ab8a-fc005f412d6a",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
